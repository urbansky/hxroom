# Betriebs-Instanz – geheime Werte für compose.yml
#
# Kopiere diese Datei nach `infra-status/.env` (auf der Betriebs-Instanz neben compose.yml).
# Nicht einchecken: `.env` steht in .gitignore.

# -----------------------------------------------------------------------------
# GlitchTip (errors.hxcode.io)
# -----------------------------------------------------------------------------
# Zufälliger Schlüssel für Sessions und Signaturen. Erzeugen: openssl rand -base64 48
GLITCHTIP_SECRET_KEY=
# Passwort der GlitchTip-Datenbank (nur im internen Netz erreichbar). Erzeugen: openssl rand -hex 24
GLITCHTIP_DB_PASSWORD=
# Mailversand für Alarme und Einladungen über Brevo-SMTP.
# Brevo → SMTP & API → SMTP: Login und SMTP-Schlüssel (nicht der API-Schlüssel).
# Sonderzeichen in Login oder Schlüssel URL-kodieren (@ → %40).
GLITCHTIP_EMAIL_URL=smtp+tls://<login>:<smtp-schluessel>@smtp-relay.brevo.com:587
# Absender der Mails – muss in Brevo als Absender bestätigt sein
GLITCHTIP_FROM_EMAIL=errors@hxcode.io
