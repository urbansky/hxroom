{
  "name": "@hxroom/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "dotenv -e .env -- tsx src/db/seed.ts",
    "admin:create": "dotenv -e .env -- tsx src/db/create-admin.ts",
    "admin:create:prod": "dotenv -e .env.prod -- tsx src/db/create-admin.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env.prod -- drizzle-kit studio",
    "email:dev": "email dev --dir src/mail/templates"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@hxroom/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "better-auth": "^1.7.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@react-email/ui": "^6.9.3",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "react-email": "^6.9.3",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.6.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
