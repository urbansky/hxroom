# API-URL (wird vom Browser aufgerufen)
# Eigener API-Host für das Backoffice – NICHT api.hxroom.*: Session-Cookies sind
# host-gebunden, sonst überschreibt der Betreiber-Login die Coach-Session desselben
# Browsers. Derselbe API-Container, nur ein zweiter Hostname (ADMIN_AUTH_URL in apps/api).
# Lokal ohne Caddy (dann teilen sich beide Apps localhost:3000 – Sessions kollidieren):
NUXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NUXT_PUBLIC_AUTH_URL=http://localhost:3000
# Lokal mit Caddy (*.hxroom.localhost), stattdessen:
# NUXT_PUBLIC_API_URL=http://admin-api.hxroom.localhost/api/v1
# NUXT_PUBLIC_AUTH_URL=http://admin-api.hxroom.localhost

# Basisdomain der Coach-Buchungsseiten, nur für die Anzeige in der Coach-Liste
# ({slug}.ROOT_DOMAIN). Default ist hxroom.de.
# NUXT_PUBLIC_ROOT_DOMAIN=hxroom.localhost
